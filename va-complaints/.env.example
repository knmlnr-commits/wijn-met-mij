# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL (local: http://127.0.0.1:54321, printed by `supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon (publishable) key; safe in the browser, all access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key; server code and seed scripts only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for the seed scripts (local: postgresql://postgres:postgres@127.0.0.1:54322/postgres).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Sandbox only: show the seeded dev login buttons (true or unset). Ignored on production deployments.
NEXT_PUBLIC_DEV_LOGIN=
# Show "Sign in with Microsoft" (Supabase Azure provider; see docs/ENTRA_SETUP.md).
AUTH_ENTRA_ENABLED=
# Email delivery: stub (default; logs a redacted line, sends nothing). The real provider is open item 8.
EMAIL_PROVIDER=stub
# Password for the three demo users created by `npm run seed:demo` (at least 12 characters).
DEMO_USER_PASSWORD=

# Optional: run the database tests (migrations, RLS per role, workflow functions) against a Postgres
# server you can create throwaway databases on. Tests are skipped when unset.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
